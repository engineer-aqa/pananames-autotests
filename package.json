{
  "name": "pananames-autotests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for the Pananames",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project='Chrome E2E tests'",
    "test:contacts": "playwright test tests/specs/ui/contacts",
    "test:domains": "playwright test tests/specs/ui/domains",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0"
  },
  "private": true
}
